{
  "name": "fling-vault",
  "productName": "FLiNG Vault",
  "version": "1.0.1",
  "private": true,
  "description": "FLiNG Vault - 风灵月影修改器库：下载、管理、快捷调用 FLiNG 修改器",
  "author": "FLiNG Vault",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build:electron && electron dist-electron/smoke.js",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.24.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "ws": "^8.18.0"
  }
}
